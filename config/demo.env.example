# Copy to config/demo.env (gitignored) and fill in. The README's "Set up" section says where each value comes from.
DATABRICKS_PROFILE=worker-safety
WORKSPACE_HOST=https://<your-workspace>.cloud.databricks.com
WORKSPACE_ID=
DEPLOYER_EMAIL=
CATALOG=workspace
SCHEMA=worker_safety
TABLE=device_events
WAREHOUSE_ID=
DEVICE_CLIENT_ID=
DEVICE_CLIENT_SECRET=
DEVICE_SP_ID=
PG_PROJECT=worker-safety
PG_DATABASE=worker_safety
APP_URL=
# off = the stick sends every event straight to the App (Free Edition). on = also stream through Zerobus into
# Delta (paid workspaces with Zerobus Ingest; also set ZEROBUS_HOST=<workspace-id>.zerobus.<region>.cloud.databricks.com)
ZEROBUS_LANE=off
ZEROBUS_HOST=
